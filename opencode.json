{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "inventario": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "inventario-mcp"
      ]
    }
  },
  "permission": {
    "edit": "ask",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "read": {
      "*": "allow",
      ".env": "deny",
      "**/.env": "deny"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff*": "allow",
      "uv run pytest*": "allow",
      "uv run inventario*": "allow",
      "ls*": "allow",
      "curl *": "deny",
      "rm *": "deny"
    }
  }
}
